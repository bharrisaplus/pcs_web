@import './story_preface.main.styl'


body:has(#turntable-conte)
    display: flex
    overflow: hidden
    justify-content: center
    align-items: center
    background-color: #4ecfec

#turntable-conte
    display: flex
    width: 100%
    height: 100%
    border-width: 0
    border-radius: 9px
    justify-content: center
    align-items: center
    background-color: rgba(99, 236, 78, 0.25)

button#loadit
    max-height: 36px
    translate: 0 0
    padding: 4px 8px
    font-size: 18px
    border-width: 0
    border-radius: 4.5px
    box-shadow: 3px 2.5px rgba(50,50,50, 0.5)
    color: #FAFAFA
    background-color: #ec6b4e
    cursor: pointer

    &:active
        box-shadow: 1.5px 1px rgba(50,50,50, 0.5)
        translate: 0 1.5px

    &:hover
        color: grey
