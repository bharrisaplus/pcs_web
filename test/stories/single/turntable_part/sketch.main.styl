@import './story_preface.styl'

:root
    font: normal 16px/1 monospace

body:has(#turntable-panel)
    display: flex
    height: calc(100% - 1rem)
    width: calc(100% - 1rem)
    margin: 0.5rem
    overflow: hidden
    justify-content: center
    align-items: center
    background-color: #4ecfec

#turntable-panel
    display: flex
    height: calc(100% - 0.5rem)
    max-height: calc(100% - 0.5rem)
    width: calc(100% - 0.5rem)
    max-width: calc(100% - 0.5rem)
    border-width: 0
    border-radius: 9px
    justify-content: center
    align-items: center
    background-color: rgba(99, 236, 78, 0.25)

    & .subject-membrane
        display: flex
        height: 450px
        min-height: 450px
        max-height: 90%
        width: 450px
        min-width: 450px
        max-width: 90%
        overflow: hidden
        resize: both
        justify-content: center
        align-items: center
        border-width: 0
        border-radius: 18px
        outline-width: 2px
        outline-style: dashed
        outline-color: rgba(236, 107, 78, 0.63)

        & iframe
            height: calc(100% - 2rem)
            max-height: calc(100% - 2rem)
            width: calc(100% - 2rem)
            max-width: calc(100% - 2rem)

    &:has(#showhide)
        position: relative


button#showhide
    max-height: 36px
    position: absolute
    right: 1rem
    bottom: 1rem
    translate: 0 0
    padding: 4px 8px
    font-size: 18px
    border-width: 0
    border-radius: 4.5px
    box-shadow: 3px 3px rgba(50,50,50, 0.5)
    color: #FAFAFA
    background-color: #ec6b4e
    /* property | duration | easing | behavior */
    transition: opacity 0.45s ease-in-out allow-discrete

    &:active
        box-shadow: 2px 2px rgba(50,50,50, 0.5)
        translate: 0 1.5px

    &:hover
        cursor: pointer

    &:disabled
        color: #333


@starting-style
    button#loadit
        opacity: 0
