extends ../preface.pug

block storey_preface_title
    title ekonte:tableau

block storey_preface_sheets
    link(rel="stylesheet" href="/tableau_part/ekonte.css")

block storey_preface_importmap
    script(type="importmap").
        {
            "imports": {
                "storey:fixtures": "/tanto.mjs"
            }
        }

block storey_preface_entry
    header
        h1 Tableau
    main#tableau-panel
        .desk-membrane
            iframe.desk-frame(src="/tableau_part/desk" sandbox="allow-same-origin allow-scripts allow-downloads")
        #test-overlay
            h2 Test Running ⌛
        #ctrl-band.load-curtain

block storey_preface_scripts
    script(src="/tableau_part/_ekonte.mjs" type="module")
