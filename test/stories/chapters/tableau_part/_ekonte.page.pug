extends ../preface.pug

block storeyboard_title
    title ekonte:tableau

block storeyboard_sheets
    link(rel="stylesheet" href="/tableau_part/ekonte.css")

block storeyboard_header
    h1 Tableau

block storeyboard_entry
    .desk-membrane
        iframe.desk-frame(src="/tableau_part/desk" sandbox="allow-same-origin allow-scripts allow-downloads")

block storeyboard_actionbar
    button#sprint Print Current Order
    button#runtest Run Test(s)
    button#a11ycheck Check a11y

block storeyboard_scripts
    script(src="/tableau_part/_ekonte.mjs" type="module")
