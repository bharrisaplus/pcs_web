extends ../preface.pug

block storey_preface_title
    title conte:tableau

block storey_preface_sheets
    link(rel="stylesheet" href="/tableau_part/conte.css")

block storey_preface_importmap
    script(type="importmap").
        {
            "imports": {
                "storey:fixtures": "/tanto.mjs"
            }
        }

block storey_preface_entry
    header
        h1 Tableau
    main#tableau-panel
        .subject-membrane
            iframe.subject-frame(src="/tableau_part/subject" sandbox="allow-same-origin allow-scripts allow-downloads")
        #test-overlay
            h2 Test Running ⌛
        #ctrl-band.load-curtain

block storey_preface_scripts
    script(src="/tableau_part/_conte.mjs" type="module")
