{
    "include": [
        "./*_part/*.mjs",
        "./*_part/clones/*.clone.mjs"
    ],
    "compilerOptions": {
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strictNullChecks": false,
        "esModuleInterop": true,
        "lib": [
            "DOM",
            "ESNext",
            "WebWorker"
        ],
        "module": "esnext",
        "target": "esnext",
        "baseUrl": ".",
        "paths": {
            "turntable_part": ["../../../source/behavior/parts/turntable.part.mjs"],
            "pcs:types": ["../../../source/behavior/_meta/_typedefs.mjs"]
        },
        "types": [
            "./_.d.ts"
        ]
    },
    "typedocOptions": {
        "jsDocCompatibility": true
    }
}