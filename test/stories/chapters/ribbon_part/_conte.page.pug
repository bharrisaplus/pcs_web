extends ../preface.pug

block storey_preface_title
    title conte:ribbon

block storey_preface_sheets
    link(rel="stylesheet" href="/ribbon_part/conte.css")

block storey_preface_importmap
    script(type="importmap").
        {
            "imports": {
                "storey:fixtures": "/tanto.mjs"
            }
        }

block storey_preface_entry
    header
        h1 Ribbon
    main#ribbon-panel
        .desk-membrane
            iframe.desk-frame(src="/ribbon_part/desk" sandbox="allow-same-origin allow-scripts allow-downloads")
        #test-overlay
            h2 Test Running ⌛
        #ctrl-band.load-curtain

block storey_preface_scripts
    script(src="/ribbon_part/_conte.mjs" type="module")
