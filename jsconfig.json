{
	"files": [
		"source/behavior/_meta/_*.mjs",
		"source/behavior/_banks/*.bank.mjs",
		"source/behavior/hands/*.hand.mjs",
		"source/behavior/lattices/*.lattice.mjs",
		"source/behavior/parts/*.part.mjs",
		"source/behavior/shuttles/*.shuttle.mjs",
		"source/behavior/index.main.mjs",
		"test/specs/*_hand.spec.mjs",
		"test/specs/*_bank.spec.mjs",
		"test/specs/*_shuttle.spec.mjs",
		"rollup.config.mjs",
		"_rollup.config.mjs",
		"postcss.config.mjs",
		"_postcss.config.mjs",
		"eslint.config.mjs"
	],
	"compilerOptions": {
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"strictNullChecks": false,
		"lib": [
			"DOM",
			"ESNext",
			"WebWorker"
		],
		"module": "esnext",
		"target": "esnext",
		"types": [
			"node"
		]
	}
}
