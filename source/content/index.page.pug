doctype html
html(lang="en")
    head
        title pcs:web
        meta(charset="UTF-8")

        //- Viewport
        meta(name="viewport" content="initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no")

        //- Robots
        meta(name="robots" content="index, follow")


        meta(name="msapplication-config" content=BROWSERCONFIG_URL)

        //- Favicons
        link(rel="apple-touch-icon" type="image/png" sizes="180x180" href=APPLE_TOUCH_ICON_URL)
        link(rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href=FAVICON_32_URL)
        link(rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href=FAVICON_32_ALT_URL)
        link(rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: light)" href=FAVICON_16_URL)
        link(rel="icon" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)" href=FAVICON_16_ALT_URL)
        link(rel="manifest" type="application/manifest+json" href=WEBMANIFEST_URL)
        link(rel="shortcut icon" type="image/vnd.microsoft.icon" media="(prefers-color-scheme: light)" href=FAVICON_ICO_URL)
        link(rel="shortcut icon" type="image/vnd.microsoft.icon" media="(prefers-color-scheme: dark)" href=FAVICON_ICO_ALT_URL)

        //- Styles
        link(rel="stylesheet" href=VENDOR_CSS_RESET_URL)
        link(rel="stylesheet" href=CSS_MAIN_URL)

        //- Scripts
        script(src=VENDOR_CHANCEJS_URL)

    body
        header
            div
                h2 (P)seudo (C)ard (S)huffler
                img(src=MARKLOGO_URL alt="A scribbly sqwiggle" height="24px" width="24px")

        main
            span(style="font-size:48px;")
                | 🂠

        footer
            if ON_FILE_HOST
                script(src=ES_MAIN_URL defer)
            else
                script.
                    document.addEventListener('DOMContentLoaded', () => {
                        PCS.echo();
                    });
                script(src=ES_MAIN_URL type="module" defer)
