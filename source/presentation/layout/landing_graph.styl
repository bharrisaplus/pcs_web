$card-whratio = 3/4
$card-height = 120px
$card-magheight = $card-height * 1.5
$card-width = $card-height * $card-whratio
$card-hspace = $card-height * (1/3)
$card-wspace = $card-width * 0.25

:root
    --card-ratio: $card-whratio
    --card-height: $card-height
    --card-magnified-height: $card-magheight
    --card-width: $card-width
    --card-hspace: $card-hspace
    --card-wspace: $card-wspace

#pcs-shell
    container: shell / size

    & header
        height: 13%
        min-height: 81px
        margin-bottom: 9px
        flex-flow: column nowrap
        justify-content: space-around
        align-items: flex-start

    & main
        height: 85%
        border-radius: 18px

    & footer
        display: none


#ribbon
    display: flex
    width: calc(100% - 9px)
    padding: 4.5px
    justify-content: space-around
    align-items: center

    & .ribbon-bow,
    & .ribbon-swish,
    & .ribbon-flourish
        display: inline-flex
        align-items: center

    & .ribbon-swish,
    & .ribbon-flourish
        width: 45%
        padding: 4.5px

    & .ribbon-swish
        justify-content: flex-end

        & > :first-child
            margin: 0 15% 0 0

    & .ribbon-flourish
        justify-content: flex-start
        gap: 0 18px

        & > :first-child
            margin: 0 0 0 15%

    & [role="tooltip"]
        position: absolute
        top: 14%
        right: 15%
        width: 300px
        padding: 7px
        z-index: 2


#brush
    & select[name="brush-wells"]
        padding: 4.5px
        border-radius: 4.5px
        border-width: 2.5px


#shuffle
    display: flex
    height: 36px
    max-height: 36px
    aspect-ratio: 1/1
    border-width: 2px
    border-radius: 50%
    justify-content: center
    align-items: baseline

    &:active
        border-width: 1px

#reset
    display: flex
    align-items: center

#claw
    display: inline-flex
    gap: 0 18px
    align-items: center

    & .claw-drop
        display: flex
        height: 26px
        aspect-ratio: 5/1
        margin-left: 18px
        border-width: 1px
        justify-content: center
        align-items: center


#reset button,
#claw button
    display: flex
    max-height: 28px
    aspect-ratio: 1/1
    padding: 4px
    border-width: 0
    border-radius: 4.5px
    justify-content: center
    align-items: center

    & svg[role="img"]
        height: 20px
        width: 20px


#pageload-curtain
    display: flex
    position: relative
    height: 100%
    width: 100%
    opacity: 1
    z-index: 10
    justify-content: center
    align-items: center

    &.loading-done
        visibility: hidden
        opacity: 0

    & .loading-indicator
        display: flex
        width: $card-height // to keep spinny within while rotating
        aspect-ratio: 1/1
        flex-flow: column nowrap
        justify-content: center
        align-items: center
        row-gap: 4.5px

        & .loading-spinny
            height: 54px
            aspect-ratio: 3/4
            padding: 4.5px
            border-radius: 4.5%

        & .loading-dots
            padding: 1.5px 4.5px


#tableau
    display: flex
    width: calc(100% - var(--card-hspace))
    height: calc(100% - var(--card-wspace))
    gap: var(--card-wspace) var(--card-hspace)
    flex-flow: row wrap
    padding: calc(var(--card-wspace) / 2) calc(var(--card-hspace) / 2)
    overflow-x: hidden
    overflow-y: auto
    justify-content: center
    align-content: space-around

    &.hide-before-load
        display: none

    & .playing-card
        height: var(--card-height)
        aspect-ratio: var(--card-ratio)

        & svg
            height: 100%
            width: 100%

#turntable
    height: calc(var(--card-magnified-height) + 100px)
    aspect-ratio: 1/1
    margin: auto
    border: 3.5px
    padding: 9px 18px 18px
    flex-flow: column wrap
    justify-content: center
    align-items: center
    gap: 18px 0

    &:popover-open
        display: flex

    & .turntable-off
        align-self: flex-end

    & .turntable-pickup
        height: calc(var(--card-magnified-height))
        aspect-ratio: 3/4

    & .turntable-cue-lever
        display: flex
        justify-content: center
        gap: 0 18px

        & .turntable-cue-lever-spacer
            display: none
            visibility: hidden

        & button
            height: 30px
            width: 35px
            border-width: 2px
            padding: 3px 9px

        & .turntable-cue-lever-regression:disabled + .turntable-cue-lever-spacer:has(+ .turntable-cue-lever-progression:disabled)
            display: inline-block
            visibility: visible
            margin: 0 4.5px

        & .turntable-cue-lever-regression:disabled:has(+ .turntable-cue-lever-spacer + .turntable-cue-lever-progression:disabled)
            visibility: hidden

        & .turntable-cue-lever-regression:disabled + .turntable-cue-lever-spacer + .turntable-cue-lever-progression:disabled
            visibility: hidden


/*
    Ancestor/Parent responsive styles
 */

@container shell (width < 800px)
    #pcs-shell
        header
            height: 17%
            min-height: 150px

        main
            max-height: calc(100% - 150px - 9px)

    #ribbon
        flex-flow: column nowrap
        align-items: flex-start

        & .ribbon-swish,
        & .ribbon-flourish
            justify-content: flex-start

        & .ribbon-swish :first-child,
        & .ribbon-flourish :first-child
            margin: 0

        & .ribbon-swish
            width: 75%

        & .ribbon-flourish
            width: 90%

        & .ribbon-bow
            align-self: flex-end
            margin: 0 4.5px 0 0

        & [role="tooltip"]
            top: 9%


    #tableau
        gap: var(--card-wspace) calc(var(--card-hspace) / 2)
