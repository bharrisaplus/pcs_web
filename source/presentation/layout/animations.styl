@keyframes yo-yo
    0%
        transform: rotate(0deg)
    25%
        transform: rotate(90deg)
    50%
        transform: rotate(180deg)
    75%
        transform: rotate(270deg)
    100%
        transform: rotate(360deg)

@keyframes dotdot-dot
    0%
        content: ""
    25%
        content: "."
    50%
        content: ".."
    100%
        content: "..."
