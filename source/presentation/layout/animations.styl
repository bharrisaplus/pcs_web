@keyframes yo-yo
    0%
        rotate: 0deg
    25%
        rotate: 90deg
    50%
        rotate: 180deg
    75%
        rotate: 270deg
    100%
        rotate: 360deg

@keyframes dotdot-dot
    0%
        content: ""
    25%
        content: "."
    50%
        content: ".."
    100%
        content: "..."

@keyframes card-drop
    0%
        opacity: 0
        transform: translateY(-20px) scale(0.95)

    100%
        opacity: 1
        transform: translateY(0) scale(1)