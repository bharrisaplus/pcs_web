@keyframes yo-yo
    0%
        transform: rotate(0deg)
    25%
        transform: rotate(90deg)
    50%
        transform: rotate(180deg)
    75%
        transform: rotate(270deg)
    100%
        transform: rotate(360deg)

@keyframes dotdot-dot
    0%
        content: ""
    25%
        content: "."
    50%
        content: ".."
    100%
        content: "..."

@keyframes card-drop
    0%
        opacity: 0
        transform: translateY(-20px) scale(0.95)

    100%
        opacity: 1
        transform: translateY(0) scale(1)