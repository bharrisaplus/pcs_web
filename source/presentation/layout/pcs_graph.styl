$card-whratio = 3/4
$card-height = 120px
$card-magheight = $card-height * 1.5
$card-width = $card-height * $card-whratio
$card-hspace = $card-height * (1/3)
$card-wspace = $card-width * 0.25

:root
    --card-ratio: $card-whratio
    --card-height: $card-height
    --card-magnified-height: $card-magheight
    --card-width: $card-width
    --card-hspace: $card-hspace
    --card-wspace: $card-wspace

#title-marquee
    display: flex
    gap: 9px
    align-items: center

    & .markl
        height: 24px
        width: 24px


#pageload-curtain
    display: flex
    position: relative
    height: 100%
    width: 100%
    opacity: 1
    z-index: 10
    justify-content: center
    align-items: center

    & .loading-indicator
        display: flex
        width: $card-height // to keep spinny within while rotating
        aspect-ratio: 1/1
        flex-flow: column nowrap
        justify-content: center
        align-items: center
        row-gap: 4.5px

        & .loading-spinny
            height: 54px
            width: fit-content
            aspect-ratio: 3/4
            padding: 4.5px
            border-radius: 4.5%

        & .loading-dots
            padding: 1.5px 4.5px


#tableau
    display: flex
    width: calc(100% - var(--card-hspace))
    height: calc(100% - var(--card-wspace))
    column-gap: var(--card-hspace)
    row-gap: var(--card-wspace)
    flex-flow: row wrap
    padding: calc(var(--card-wspace) / 2) calc(var(--card-hspace) / 2)
    overflow-x: hidden
    overflow-y: auto
    justify-content: center
    align-content: space-around

    & .playing-card
        height: var(--card-height)
        aspect-ratio: var(--card-ratio)

        & svg
            height: 100%
            width: 100%

#turntable
    height: calc(var(--card-magnified-height) + 100px)
    aspect-ratio: 1/1
    margin: auto
    border: 3.5px
    padding: 9px 18px 18px
    flex-flow: column wrap
    justify-content: center
    align-items: center
    gap: 18px

    &:popover-open
        display: flex

    & .turntable-off
        align-self: flex-end

    & .turntable-pickup
        height: calc(var(--card-magnified-height))
        aspect-ratio: 3/4

    & .turntable-cue-lever
        display: flex
        width: 100%
        flex-flow: row nowrap
        justify-content: center
        column-gap: 18px

        & button
            padding: 3px 9px
