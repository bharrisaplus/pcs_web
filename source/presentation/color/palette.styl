$card-table-green = #1c5e3d
$card-stock = #F7F7F7
$pcs-black = #333

// debug colors (for z-index, borders, margins, padding, etc)
$cool-grey = #8789C0
$lion = #BB9457
$peach = #FFE6A7
$fl-cyan = #81F0E5

:root
	--loading-curtain: rgba($pcs-black, 0.36)
	--turntable-curtain: rgba($pcs-black, 0.75)
	--turntable-curtain-blend: rgba($pcs-black, 0.375)
	--card-base: $card-stock
	--bg-emerald: $card-table-green

	--debug-1-color: $cool-grey
	--debug-2-color: $lion
	--debug-3-color: $peach
	--debug-4-color: $fl-cyan
