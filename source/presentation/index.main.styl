@import 'color/palette.styl'
@import 'typography/_typeset.styl'
@import 'layout/_graph.styl'
@import 'layout/animations.styl'

@import 'typography/pcs_typeset.styl'
@import 'layout/pcs_graph.styl'


#pcs-shell
    & main
        background: var(--bg-emerald)


#title-marquee h2
    user-select: none
    pointer-events: none

#ribbon
    background-color: var(--debug-1-color)

    & .ribbon-swish, & .ribbon-flourish
        background-color: var(--debug-2-color)

    & .ribbon-bow
        background-color: var(--debug-3-color)

#brush
    & select
        border-style: ridge


#pageload-curtain
    border-radius: inherit
    background-color: var(--loading-curtain)

    & .loading-indicator
        background-color: transparent

        & .loading-spinny
            background-color: var(--card-base)
            rotate: 0deg

        & .loading-dots
            color: var(--card-base)
            background-color: inherit
            user-select: none
            pointer-events: none


#tableau
    background-color: inherit
    border-radius: inherit
    list-style: none

    &:has(+ :popover-open) .playing-card
        cursor: default
        pointer-events: none

    & .playing-card
        cursor: pointer
        rotate: 0deg


#turntable
    background-color: inherit
    border-color: var(--turntable-dustcover-mix)
    border-radius: inherit
    opacity: 0

    &::backdrop
        background-color: transparent
        backdrop-filter: none

    &:popover-open
        opacity: 1

        &::backdrop
            background-color: var(--turntable-dustcover)
            backdrop-filter: blur(3px)

    & button
        cursor: pointer

    & .turntable-off
        color: var(--card-base)
        background-color: transparent
        border-color: transparent

    & .turntable-pickup
        cursor: default
        user-select: none

    & .turntable-cue-lever
        background-color: transparent

        & button
            background-color: var(--card-base)
            border-color: var(--turntable-dustcover-mix)
            border-radius: 18%
            border-width: 2px

            &:disabled
                cursor not-allowed

    & .turntable-cue-lever-spacer
        display: none
        visibility: hidden
        color: var(--card-base)

    & .turntable-cue-lever-regression:disabled + .turntable-cue-lever-spacer:has(+ .turntable-cue-lever-progression:disabled)
        display: inline-block
        visibility: visible
        margin: 0 4.5px

        &::before
            content: "\2234"

        &::after
            content: "\1F382"

    & .turntable-cue-lever-regression:disabled:has(+ .turntable-cue-lever-spacer + .turntable-cue-lever-progression:disabled)
        visibility: hidden

    & .turntable-cue-lever-regression:disabled + .turntable-cue-lever-spacer + .turntable-cue-lever-progression:disabled
        visibility: hidden


/*
    setup transitions & animations
 */

#pageload-curtain
    transition-property: opacity
    transition-delay: 0.1s
    transition-duration: 0.2s
    transition-behavior: allow-discrete

    & .loading-indicator .loading-spinny
        animation-name: yo-yo
        animation-delay: 0.4s
        animation-duration: 1.5s
        animation-iteration-count: 36
        animation-timing-function: ease-in-out
        animation-direction: alternate

    & .loading-indicator .loading-dots span
        animation-delay: 0.4s
        animation-duration: 1.5s
        animation-iteration-count: 36
        animation-timing-function: ease-out
        animation-direction: alternate
        color: var(--card-base)

        &:nth-child(1)
            animation-name: dotdot-dot
        &:nth-child(2)
            animation-name: dotdot-dotdot
        &:nth-child(3)
            animation-name: dotdot-dotdotdot

    &.loading-done
        visibility: hidden
        opacity: 0
        z-index: -1

        & .loading-indicator .loading-spinny,
        & .loading-indicator .loading-dots span
            animation-play-state: paused


#tableau
    & .playing-card
        animation-name: card-drop
        animation-duration: 0.25s
        animation-timing-function: ease-out
        animation-fill-mode: backwards
        transition: rotate 0.2s

    &.hide-before-load
        display: none

#turntable
    transition: all 0.7s ease-in-out allow-discrete

    &::backdrop
        transition: all 0.7s ease-in-out allow-discrete

@starting-style
    #pageload-curtain .loading-indicator .loading-spinny
        rotate: 0deg

    .loading-indicator .loading-dots span
        opacity: 0

    #tableau .playing-card
        rotate: 0deg
        opacity: 1

    #turntable:popover-open
        opacity: 0

        &::backdrop
            background-color: transparent
            backdrop-filter: none


@media (hover: hover)
    #tableau .playing-card:hover
        rotate: -9deg
